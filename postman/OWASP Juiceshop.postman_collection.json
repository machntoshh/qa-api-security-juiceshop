    {
      "name": "Basket",
      "item": [
        {
          "name": "Add basket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Item added with corect ProductID and quantity\", function(){\r\n    const json = pm.response.json();\r\n    pm.expect(json.data.ProductId).to.eql(1);\r\n    pm.expect(json.data.quantity).to.eql(1);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"ProductId\": 1,\r\n  \"BasketId\": \"{{bid}}\",\r\n  \"quantity\": 1\r\n}",
