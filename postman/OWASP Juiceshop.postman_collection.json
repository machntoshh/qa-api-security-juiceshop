                  "});\r",
                  "\r",
                  "pm.test(\"Return JWT token and bid\", function(){\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json.authentication.token).to.be.a(\"string\").and.not.empty;\r",
                  "    pm.expect(json.authentication).to.have.property(\"bid\");\r",
                  "\r",
                  "    pm.environment.set(\"token\", json.authentication.token);\r",
                  "    pm.environment.set(\"bid\", json.authentication.bid);\r",
                  "});"
