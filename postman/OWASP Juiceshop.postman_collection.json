          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function() {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains user ID and E-mail\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json.data).to.have.property(\"id\");\r",
                  "    pm.expect(json.data.email).to.eql(\"qa.postman@mail.com\")\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"qa.postman@mail.com\",\r\n  \"password\": \"Password123!\",\r\n  \"passwordRepeat\": \"Password123!\",\r\n  \"securityAnswer\": \"Narnia\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
